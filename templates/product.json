        "collapsible_row_JAeMLj": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is Styria Mini an official SlimeVR product?",
            "icon": "none",
            "row_content": "<p>No. Styria Mini is a third-party, fully SlimeVR-compatible full-body tracking system. It is not manufactured or endorsed by SlimeVR, but it works seamlessly with the SlimeVR open-source ecosystem and is developed based on the Smol Slime project.</p>",
            "page": ""
          }
        },
        "collapsible_row_KnhtfA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does Styria Mini work with SlimeVR Server and VRChat?",
            "icon": "none",
            "row_content": "<p>Yes. It connects to SlimeVR Server on PC and provides full-body tracking in VRChat, VTubing tools, motion-capture software, and other applications supported by the SlimeVR ecosystem.</p>",
            "page": ""
          }
        },
        "collapsible_row_P7Dinr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Does Styria Mini require Wi-Fi or router setup?",
            "icon": "none",
            "row_content": "<p>No. Styria Mini uses its own 2.4G wireless receiver and does not require any Wi-Fi configuration, unlike Wi-Fi-based SlimeVR trackers that depend on routers and 2.4 GHz network setup.</p>",
            "page": ""
          }
        },
        "collapsible_row_reJpFF": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is DIY assembly or 3D printing required?",
            "icon": "none",
            "row_content": "<p>No DIY is required. Styria Mini ships fully assembled with trackers, receiver, dock, straps, and storage case included.</p>",
            "page": ""
          }
        },
        "collapsible_row_93jMbE": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which headsets and platforms are supported?",
            "icon": "none",
            "row_content": "<p>Any headset that works with SteamVR can use Styria Mini, including PCVR headsets and Quest/Quest 3 used via PC streaming (Link/Air Link/Virtual Desktop).</p>",
            "page": ""
          }
        },
        "collapsible_row_4Ygx3K": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What support is available for setup?",
            "icon": "none",
            "row_content": "<p>Direct support channels are available for setup questions, with each inquiry answered individually. SlimeVR documentation and community guides also apply.</p>",
            "page": ""
          }
        }
