{{ 'section-highlight.css' | asset_url | stylesheet_tag }}

<div class="section-highlight" data-block-count="{{ section.blocks.size }}">
  <div class="page-width highlight__container">
    <div class="highlight__heading">HIGHLIGHTS</div>
    {%- comment -%} 1. Render Highlight Items in Masonry Grid (Use image_card) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="highlight__grid">
        {%- comment -%} Column 1: Item 1 and 4 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 0 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title != blank -%}
                    <div class="highlight-card__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Column 2: Item 2 and 5 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 1 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title != blank -%}
                    <div class="highlight-card__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Column 3: Item 3 and 6 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 2 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title != blank -%}
                    <div class="highlight-card__title">{{ block.settings.title }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 2. Render Banner Blocks as Carousel (Use image_banner) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="highlight__banners" id="highlight-banner-carousel">
        <div class="highlight__carousel-wrapper">
          <div class="highlight__carousel-track">
            {%- for block in section.blocks -%}
              <div
                class="highlight-card highlight-card--banner highlight__carousel-slide"
                data-slide-index="{{ forloop.index0 }}"
              >
                {%- if section.settings.link != blank -%}
                  <a href="{{ section.settings.link }}" class="highlight-card__link-overlay">
                {%- endif -%}

                {%- if block.settings.image_banner != blank -%}
                  {{ block.settings.image_banner | image_url: width: 1200 | image_tag: class: 'highlight-card__image' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  <div class="highlight-card__text-container">
                    {%- if block.settings.title != blank -%}
                      <div class="highlight-card__title">{{ block.settings.title }}</div>
                    {%- endif -%}
                    {%- if block.settings.subtitle != blank -%}
                      <div class="highlight-card__description rte">{{ block.settings.subtitle }}</div>
                    {%- endif -%}
                  </div>
                </div>

                {%- if section.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.blocks.size > 1 -%}
          <button class="highlight__carousel-button highlight__carousel-button--prev" aria-label="Previous banner">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button class="highlight__carousel-button highlight__carousel-button--next" aria-label="Next banner">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="highlight__carousel-dots">
            {%- for block in section.blocks -%}
              <button
                class="highlight__carousel-dot {% if forloop.first %}highlight__carousel-dot--active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                aria-label="Go to slide {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <div style="text-align: center; padding: 20px; color: #000;">
        <p>No blocks added. Please add blocks in the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const carousel = document.getElementById('highlight-banner-carousel');
    if (!carousel) return;

    const carouselTrack = carousel.querySelector('.highlight__carousel-track');
    const slides = carousel.querySelectorAll('.highlight__carousel-slide');
    const prevButton = carousel.querySelector('.highlight__carousel-button--prev');
    const nextButton = carousel.querySelector('.highlight__carousel-button--next');
    const dots = carousel.querySelectorAll('.highlight__carousel-dot');

    let currentSlide = 0;
    const totalSlides = slides.length;

    // 切换到指定幻灯片
    function goToSlide(index) {
      if (index < 0 || index >= totalSlides) return;

      currentSlide = index;

      // 更新幻灯片位置
      carouselTrack.style.transform = `translateX(-${currentSlide * 100}%)`;

      // 更新指示点
      dots.forEach((dot, i) => {
        if (i === currentSlide) {
          dot.classList.add('highlight__carousel-dot--active');
        } else {
          dot.classList.remove('highlight__carousel-dot--active');
        }
      });
    }

    // 上一张
    if (prevButton) {
      prevButton.addEventListener('click', function () {
        goToSlide(currentSlide - 1);
      });
    }

    // 下一张
    if (nextButton) {
      nextButton.addEventListener('click', function () {
        goToSlide(currentSlide + 1);
      });
    }

    // 点击指示点
    dots.forEach((dot, index) => {
      dot.addEventListener('click', function () {
        goToSlide(index);
      });
    });

    // 处理 card 向下按钮点击
    const scrollButtons = document.querySelectorAll('.highlight-card__scroll-button');

    scrollButtons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const targetBannerIndex = this.getAttribute('data-target-banner').replace('banner-', '');
        const slideIndex = parseInt(targetBannerIndex, 10);

        // 滚动到轮播区域
        carousel.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });

        // 切换到对应的 banner
        setTimeout(function () {
          goToSlide(slideIndex);
        }, 300); // 等待滚动动画开始后再切换
      });
    });
  });
</script>

{% schema %}
{
  "name": "Highlight Section",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Card Link",
      "info": "This link will apply to all cards in this section."
    }
  ],
  "blocks": [
    {
      "type": "highlight_item",
      "name": "Highlight Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_card",
          "label": "Card Image (Grid)"
        },
        {
          "type": "image_picker",
          "id": "image_banner",
          "label": "Banner Image (Full Width)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Heading Text"
        },
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "<p>Subtitle text here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Highlight Section",
      "blocks": [
        {
          "type": "highlight_item",
          "settings": {
            "title": "SHIPS IMMEDIATELY, NO WAITING",
            "subtitle": "<p>Skip the wait - no pre-orders, no delays. The complete tracking kit is ready to ship the moment you order, getting you into your virtual world without the agonizing wait.</p>"
          }
        },
        {
          "type": "highlight_item",
          "settings": {
            "title": "TOP-TIER ALGORITHM, NO MORE FOOT SLIDE",
            "subtitle": "<p>Lighter than both the 50g Wi-Fi version and the upcoming 12g Butterfly. The hook-surface backing attaches instantly to straps and pads, enabling flexible placement and effortless adjustment.</p>"
          }
        },
        {
          "type": "highlight_item",
          "settings": {
            "title": "48+ HOUR LONG BATTERY LIFE",
            "subtitle": "<p>Last over 48 hours of play time on one battery charge with a tiny 120 mAh battery! You would only need to charge them about once every 2 weeks or less if you play a few hours a day.</p>"
          }
        },
        {
          "type": "highlight_item",
          "settings": {
            "title": "NO WI-FI CONFIG, PLUG-AND-PLAY",
            "subtitle": "<p>22 dBm high-gain 2.4G receiver delivers a strong and reliable wireless link for smooth motion tracking, enabling instant plug-and-play operation without any Wi-Fi setup.</p>"
          }
        },
        {
          "type": "highlight_item",
          "settings": {
            "title": "10-IN-1 QUICK CHARGING DOCK",
            "subtitle": "<p>All-in-one dock centralizes charging, storage, fast pairing, and one-touch temperature calibration, keeping the entire tracker set organized and effortlessly managed.</p>"
          }
        },
        {
          "type": "highlight_item",
          "settings": {
            "title": "1-ON-1 ONBOARDING SUPPORT",
            "subtitle": "<p>New to FBT? We provide 1-on-1 onboarding to help you get started smoothly.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
