{{ 'section-highlight.css' | asset_url | stylesheet_tag }}

<div class="section-highlight" data-block-count="{{ section.blocks.size }}">
  <div class="page-width highlight__container">
    <div class="highlight__heading">HIGHLIGHTS</div>
    {%- comment -%} 1. Render Highlight Items in Masonry Grid (Use image_card) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="highlight__grid">
        {%- comment -%} Column 1: Item 1 and 4 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 0 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title_card != blank -%}
                    <div class="highlight-card__title rte">{{ block.settings.title_card }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="12.14" height="20" viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.5674 7.0752L0 7.0752V5.06543L13.5674 5.06543V7.0752ZM19.7588 5.42676C20.0804 5.80867 20.0804 6.33196 19.7588 6.71387L15.2363 12.1406L13.709 10.8545L17.6885 6.07031L13.709 1.28613L15.2363 0L19.7588 5.42676Z" fill="white"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Column 2: Item 2 and 5 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 1 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title_card != blank -%}
                    <div class="highlight-card__title rte">{{ block.settings.title_card }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="12.14" height="20" viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.5674 7.0752L0 7.0752V5.06543L13.5674 5.06543V7.0752ZM19.7588 5.42676C20.0804 5.80867 20.0804 6.33196 19.7588 6.71387L15.2363 12.1406L13.709 10.8545L17.6885 6.07031L13.709 1.28613L15.2363 0L19.7588 5.42676Z" fill="white"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Column 3: Item 3 and 6 {%- endcomment -%}
        <div class="highlight__column">
          {%- for block in section.blocks -%}
            {%- assign mod = forloop.index0 | modulo: 3 -%}
            {%- if mod == 2 -%}
              <div class="highlight-card" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image_card != blank -%}
                  {{
                    block.settings.image_card
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', class: 'highlight-card__image'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
                {%- endif -%}

                <div class="highlight-card__content">
                  {%- if block.settings.title_card != blank -%}
                    <div class="highlight-card__title rte">{{ block.settings.title_card }}</div>
                  {%- endif -%}
                </div>

                <button
                  class="highlight-card__scroll-button"
                  data-target-banner="banner-{{ forloop.index0 }}"
                  aria-label="Scroll to banner"
                >
                  <svg width="12.14" height="20" viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.5674 7.0752L0 7.0752V5.06543L13.5674 5.06543V7.0752ZM19.7588 5.42676C20.0804 5.80867 20.0804 6.33196 19.7588 6.71387L15.2363 12.1406L13.709 10.8545L17.6885 6.07031L13.709 1.28613L15.2363 0L19.7588 5.42676Z" fill="white"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 2. Render Banner Blocks Second (Vertical Layout - Use image_banner) {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="highlight__banners">
        {%- for block in section.blocks -%}
          <div class="highlight-card highlight-card--banner" id="banner-{{ forloop.index0 }}">
            {%- if section.settings.link != blank -%}
              <a href="{{ section.settings.link }}" class="highlight-card__link-overlay">
            {%- endif -%}

            {%- if block.settings.image_banner != blank -%}
              {{
                block.settings.image_banner
                | image_url: width: 1200
                | image_tag: loading: 'lazy', class: 'highlight-card__image'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg highlight-card__image' }}
            {%- endif -%}

            <div class="highlight-card__content">
              <div class="highlight-card__text-container">
                {%- if block.settings.title_banner != blank -%}
                  <div class="highlight-card__title rte">{{ block.settings.title_banner }}</div>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <div class="highlight-card__description rte">{{ block.settings.subtitle }}</div>
                {%- endif -%}
              </div>
            </div>

            <button class="highlight-card__banner-button" aria-label="Banner button">
              <svg width="12.14" height="20" viewBox="0 0 20 13" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.43262 7.0752L20 7.0752V5.06543L6.43262 5.06543V7.0752ZM0.241211 5.42676C-0.0803957 5.80867 -0.0803957 6.33196 0.241211 6.71387L4.76367 12.1406L6.29102 10.8545L2.31152 6.07031L6.29102 1.28613L4.76367 0L0.241211 5.42676Z" fill="white"/>
              </svg>
            </button>

            {%- if section.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <div style="text-align: center; padding: 20px; color: #000;">
        <p>No blocks added. Please add blocks in the theme editor.</p>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const scrollButtons = document.querySelectorAll('.highlight-card__scroll-button');

    scrollButtons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const targetBannerId = this.getAttribute('data-target-banner');
        const targetBanner = document.getElementById(targetBannerId);

        if (targetBanner) {
          targetBanner.scrollIntoView({
            behavior: 'smooth',
            block: 'center',
          });
        }
      });
    });

    const bannerButtons = document.querySelectorAll('.highlight-card__banner-button');

    bannerButtons.forEach(function (button) {
      button.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const highlightHeading = document.querySelector('.highlight__heading');
        if (highlightHeading) {
          const headingPosition = highlightHeading.getBoundingClientRect().top + window.pageYOffset;
          const offset = 100;

          window.scrollTo({
            top: headingPosition - offset,
            behavior: 'smooth',
          });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Highlight Section",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Card Link",
      "info": "This link will apply to all cards in this section."
    }
  ],
  "blocks": [
    {
      "type": "highlight_item",
      "name": "Highlight Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_card",
          "label": "Card Image (Grid)"
        },
        {
          "type": "image_picker",
          "id": "image_banner",
