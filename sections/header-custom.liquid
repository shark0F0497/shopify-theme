<style>
  header-drawer {
    justify-self: start;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .header__icons {
    margin-right: 210px;
  }

  .header__icons .header__icon,
  .header__icons .localization-form,
  .header__icons .localization-form__select,
  .header__icons .desktop-localization-wrapper * {
    cursor: pointer;
  }

  .header__inline-menu {
    display: flex;
    align-items: center;
    height: 100%;
  }

  @media screen and (max-width: 990px) {
    .header__inline-menu {
      display: none;
    }

    header-drawer {
      display: block !important;
      grid-column: 1;
      justify-self: start;
    }

    .header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: 1rem;
    }

    .header__heading,
    .header__heading-link {
      grid-column: 2;
      justify-self: center;
      margin: 0;
    }

    .header__icons {
      grid-column: 3;
      justify-self: end;
      margin-right: 210px;
    }

    /* Handle mobile logo position left - force center for now as requested */
    .header--mobile-left {
      grid-template-columns: 1fr auto 1fr;
    }

    .header--mobile-left .header__heading,
    .header--mobile-left .header__heading-link {
      grid-column: 2;
      justify-self: center;
      margin-left: 0;
    }

    .header--mobile-left .header__icons {
      grid-column: 3;
    }
  }


  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 50px;
    align-items: center;
  }

  .header__inline-menu .list-menu--inline > li {
    display: flex;
    align-items: center;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    font-family: 'Azeret Mono', 'Courier New', Courier, monospace;
    font-size: 12px;
    font-weight: 400;
    font-style: normal;
    line-height: 12px;
    color: #F3F5F2;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 0;
    padding-top: 0;
    font-family: 'Azeret Mono', 'Courier New', Courier, monospace;
    font-size: 12px;
    font-weight: 400;
    font-style: normal;
    line-height: 12px;
    color: #F3F5F2;
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0;
      padding-top: 0;
    }
  }

  /* Prevent width change when menu items become bold */
  .header__inline-menu .header__menu-item {
    position: relative;
  }

  .header__inline-menu .header__menu-item span {
    display: inline-block;
    position: relative;
  }

  /* Use pseudo-element to maintain width when bold */
  .header__inline-menu .header__menu-item span::before {
    content: attr(data-text);
    font-weight: bold;
    height: 0;
    visibility: hidden;
    overflow: hidden;
    user-select: none;
    pointer-events: none;
    display: block;
    white-space: nowrap;
  }

  /* Remove default highlight from active menu items */
  .header__inline-menu .header__menu-item span.header__active-menu-item {
    font-weight: 400;
    color: #F3F5F2;
  }

  /* Highlight on hover for all menu items */
  .header__inline-menu .header__menu-item:hover span,
  .header__inline-menu .header__menu-item:hover .header__active-menu-item {
    font-weight: bold;
    color: #fff;
  }

  /* Also override base.css styles */
  .header__inline-menu .header__active-menu-item {
    font-weight: 400 !important;
    color: #F3F5F2 !important;
  }

  .header__inline-menu .header__menu-item:hover .header__active-menu-item {
    font-weight: bold !important;
    color: #fff !important;
  }

  /* Product menu hover styles */
  .header__product-menu-item {
    position: relative;
  }

  .header__product-menu-wrapper {
    position: relative;
  }

  /* Product dropdown menu styles based on Figma design */
  .header__product-menu-wrapper .header__submenu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-1.5rem);
    transition: opacity var(--duration-default) ease, transform var(--duration-default) ease, visibility var(--duration-default) ease;
    z-index: 1;
    width: 134px;
    max-height: 200px;
    overflow-y: auto;
    overflow-x: hidden;
    background-color: #151515 !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 6px !important;
    padding: 16px 0 !important;
    margin-top: 0.5rem;
    gap: 10px;
    display: flex;
    flex-direction: column;
    box-shadow: none;
  }

  .header__product-menu-item:hover .header__submenu,
  .header__product-menu-wrapper:hover .header__submenu,
  .header__product-menu-item:hover .header__submenu,
  .header__product-menu-wrapper .header__submenu:hover {
    transform: translateX(-50%) translateY(0);
  }


  /* Custom scrollbar for Product submenu */
  .header__product-menu-wrapper .header__submenu::-webkit-scrollbar {
    width: 4px;
  }

  .header__product-menu-wrapper .header__submenu::-webkit-scrollbar-track {
    background: transparent;
  }

  .header__product-menu-wrapper .header__submenu::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  .header__product-menu-wrapper .header__submenu::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .header__product-menu-wrapper .header__submenu li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__product-menu-wrapper .header__submenu .header__menu-item {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 14px 20px !important;
    font-family: 'Azeret Mono', 'Courier New', Courier, monospace !important;
    font-weight: 400 !important;
    font-size: 12px !important;
    line-height: 1em !important;
    text-align: center !important;
    color: #F3F5F2 !important;
    text-decoration: none !important;
    width: 100%;
    border-radius: 0;
    transition: background-color var(--duration-short) ease;
    margin: 0;
    letter-spacing: 0;
  }

  .header__product-menu-wrapper .header__submenu .header__menu-item:hover,
  .header__product-menu-wrapper .header__submenu .header__menu-item.list-menu__item--active {
    background-color: #2D2D2D !important;
    color: #F3F5F2 !important;
    text-decoration: none !important;
  }

  .header__product-menu-wrapper .header__submenu .header__menu-item:after {
    display: none !important;
  }

  /* Create a bridge between menu item and submenu for smooth hover */
  .header__product-menu-item::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.5rem;
    z-index: 2;
  }

  .header__product-menu-item:hover .header__submenu,
  .header__product-menu-wrapper:hover .header__submenu,
  .header__product-menu-item:hover .header__submenu,
  .header__product-menu-wrapper .header__submenu:hover {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__product-menu-item:hover .header__menu-item,
  .header__product-menu-wrapper:hover .header__menu-item {
    color: #fff;
  }

  .header__product-menu-item:hover .header__menu-item span {
    color: #fff;
    font-weight: bold;
  }

  .header__product-menu-item:hover .header__menu-item .icon-caret {
    transform: rotate(180deg);
  }

  /* Keep menu visible when hovering over submenu */
  .header__product-menu-item .header__submenu:hover {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateX(-50%) translateY(0) !important;
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 0 {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 0;
    min-height: 80px;
    height: 80px;
  }

  .header.page-width {
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    top: 20px;
    z-index: 999;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      margin-top: 0;
      margin-bottom: 0;
    }
  }

  {% if request.page_type == 'index' %}
    .section-header {
      position: fixed;
      width: 100%;
      top: 20px;
      z-index: 999;
      background: transparent;
    }
  {% endif %}

  .header__heading-link {
    position: absolute;
    top: 26px;
    left: 209px;
    padding: 0;
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
    {% render 'header-custom-drawer' %}
    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        <img src="{{ 'styria.svg' | asset_url }}" alt="{{ shop.name }}" width="104" height="28" loading="lazy">
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      render 'header-custom-menu'
    %}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        <img src="{{ 'styria.svg' | asset_url }}" alt="{{ shop.name }}" width="104" height="28" loading="lazy">
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
      <div class="desktop-localization-wrapper">
        <localization-form class="small-hide medium-hide" data-prevent-hide>
          {%- form 'localization', id: 'HeaderCustomLocalizationForm', class: 'localization-form' -%}
            {%- render 'custom-localization', localPosition: 'HeaderCustomLocalization' -%}
          {%- endform -%}
        </localization-form>
      </div>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}"
          rel="nofollow"
        >
          {%- if section.settings.enable_customer_avatar -%}
            <account-icon>
              {%- if customer and customer.has_avatar? -%}
                {{ customer | avatar }}
              {%- else -%}
                <span class="header__icon--account-empty">
                  {{- 'icon-account.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </account-icon>
          {%- else -%}
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);

  // Handle Product menu: hide dropdown when clicking on submenu items
  document.addEventListener('DOMContentLoaded', function () {
    const productMenuItem = document.querySelector('.header__product-menu-item');
    const productSubmenu = document.querySelector('#HeaderMenu-MenuList-Product');

    if (productMenuItem && productSubmenu) {
      const submenuLinks = productSubmenu.querySelectorAll('a');

      // Hide menu when clicking on submenu items
      submenuLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          // Force hide the submenu by adding a class
          productSubmenu.classList.add('header__submenu--hidden');
          productSubmenu.style.opacity = '0';
          productSubmenu.style.visibility = 'hidden';
          productSubmenu.style.transform = 'translateY(-1.5rem)';
        });
      });

      // Show menu again when hovering over the menu item
      productMenuItem.addEventListener('mouseenter', function () {
        productSubmenu.classList.remove('header__submenu--hidden');
        productSubmenu.style.opacity = '';
        productSubmenu.style.visibility = '';
        productSubmenu.style.transform = '';
      });
    }
  });
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

