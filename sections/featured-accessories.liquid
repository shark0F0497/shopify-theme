{{ 'section-featured-accessories.css' | asset_url | stylesheet_tag }}

<div class="section-featured-accessories">
  <div class="page-width featured-accessories__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="featured-accessories__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="featured-accessories__grid">
      {%- for block in section.blocks -%}
        <div class="featured-accessories__card" {{ block.shopify_attributes }}>
          {%- assign product = block.settings.product -%}
          {%- assign image = block.settings.image | default: product.featured_image -%}
          {%- assign title = block.settings.title | default: product.title -%}
          {%- assign url = product.url | default: '#' -%}

          <div class="featured-accessories__image-wrapper">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 600
                | image_tag: loading: 'lazy', class: 'featured-accessories__image', widths: '300, 600'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg featured-accessories__image' }}
            {%- endif -%}
          </div>

          <div class="featured-accessories__title">
            {{ title | default: 'Product Title' }}
          </div>

          <a href="{{ url }}" class="featured-accessories__button">
            <svg viewBox="0 0 20 20" class="icon icon-cart" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M10 2a4 4 0 00-4 4v2H3.5a.5.5 0 00-.5.5v10a.5.5 0 00.5.5h13a.5.5 0 00.5-.5v-10a.5.5 0 00-.5-.5H14V6a4 4 0 00-4-4zm2 6V6a2 2 0 00-4 0v2h4zm-8 1v9h12V9H4z" fill="currentColor"/>
              <path d="M12.5 12a.5.5 0 01.5.5v2a.5.5 0 01-1 0v-2a.5.5 0 01.5-.5zM7.5 12a.5.5 0 01.5.5v2a.5.5 0 01-1 0v-2a.5.5 0 01.5-.5z" fill="currentColor"/>
            </svg>
            BUY NOW
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Accessories",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ACCESSORIES"
    }
  ],
  "blocks": [
    {
      "type": "accessory",
      "name": "Accessory Product",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides the product featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Overrides the product title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Accessories",
      "blocks": [
        {
          "type": "accessory"
        },
        {
          "type": "accessory"
        },
        {
          "type": "accessory"
        }
      ]
    }
  ]
}
{% endschema %}
