{% comment %}
  Renders a standard custom style menu for the header.

  Usage:
  {% render 'header-custom-menu' %}
{% endcomment %}

{%- liquid
  assign is_homepage = false
  if request.page_type == 'index' or request.path == routes.root_url
    assign is_homepage = true
  endif

  assign is_product_page = false
  if request.page_type == 'product'
    assign is_product_page = true
  endif

  assign is_service_page = false
  if request.page_type == 'page' and page.handle == 'service-support'
    assign is_service_page = true
  endif

  assign service_support_url = '/pages/service-support'
  assign tutorial_url = 'https://example.com/tutorial'
-%}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- comment -%} Homepage Menu Item {%- endcomment -%}
    <li>
      <a
        id="HeaderMenu-homepage"
        href="{{ routes.root_url }}"
        class="header__menu-item list-menu__item link link--text focus-inset{% if is_homepage %} header__menu-item--active{% endif %}"
        {% if is_homepage %}
          aria-current="page"
        {% endif %}
      >
        <span
          data-text="{{ 'Homepage' | escape }}"
          {%- if is_homepage %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- 'Homepage' | escape -}}
        </span>
      </a>
    </li>

    {%- comment -%} Product Menu with Dropdown {%- endcomment -%}
    <li class="header__product-menu-item">
      <div class="header__product-menu-wrapper">
        <a
          href="#"
          id="HeaderMenu-Product"
          class="header__menu-item list-menu__item link link--text focus-inset{% if is_product_page %} header__menu-item--active{% endif %}"
          aria-expanded="false"
          aria-haspopup="true"
          onclick="return false;"
        >
          <span
            data-text="{{ 'Product' | escape }}"
            {%- if is_product_page %}
              class="header__active-menu-item"
            {% endif %}
          >
            {{- 'Product' | escape -}}
          </span>
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </a>
        <ul
          id="HeaderMenu-MenuList-Product"
          class="header__submenu header__submenu--hidden list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
          role="list"
          tabindex="-1"
        >
          {%- liquid
            assign product_items = 'styria-mini-tracker,receiver,storage-case,strap' | split: ','
            assign product_titles = 'Styria Mini Tracker,Receiver,Storage Case,Strap' | split: ','
          -%}
          {%- for product_handle in product_items -%}
            {%- assign product_index = forloop.index0 -%}
            {%- assign product_title = product_titles[product_index] -%}
            {%- liquid
              assign is_current_product = false
              if request.page_type == 'product' and product.handle == product_handle
                assign is_current_product = true
              endif

              assign product_url = '/products/' | append: product_handle
              for menu_product in collections.all.products
                if menu_product.handle == product_handle
                  assign product_url = menu_product.url
                  break
                endif
              endfor
            -%}
            <li>
              <a
                id="HeaderMenu-Product-{{ product_handle }}"
                href="{{ product_url }}"
                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if is_current_product %} list-menu__item--active{% endif %}"
                {% if is_current_product %}
                  aria-current="page"
                {% endif %}
              >
                {{ product_title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </li>

    {%- comment -%} Service & Support Menu Item {%- endcomment -%}
    <li>
      <a
        id="HeaderMenu-service-support"
        href="{{ service_support_url }}"
        class="header__menu-item list-menu__item link link--text focus-inset{% if is_service_page %} header__menu-item--active{% endif %}"
        {% if is_service_page %}
          aria-current="page"
        {% endif %}
      >
        <span
          data-text="{{ 'Service&Support' | escape }}"
          {%- if is_service_page %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- 'Service&Support' | escape -}}
        </span>
      </a>
    </li>

    {%- comment -%} Tutorial External Link {%- endcomment -%}
    <li>
      <a
        id="HeaderMenu-tutorial"
        href="{{ tutorial_url }}"
        class="header__menu-item list-menu__item link link--text focus-inset"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-text="{{ 'Tutorial' | escape }}">
          {{- 'Tutorial' | escape -}}
        </span>
      </a>
    </li>
  </ul>
</nav>
