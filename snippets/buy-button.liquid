{% comment %}
  Renders a reusable buy button.
  Accepts:
  - text: {String} The text to display on the button.
  - link: {String} The URL the button links to.
  - class: {String} Optional additional classes.
  - icon: {String} Optional icon file name (default: 'icon-buy.svg').

  Usage:
  {% render 'buy-button', text: 'Buy Now', link: product.url %}
  {% render 'buy-button', text: 'Watch Video', link: '#', icon: 'video.svg' %}
{% endcomment %}

<a
  href="{{ link | default: '#' }}"
  class="custom-buy-button {{ class }}"
  {% if link == blank %}
    aria-disabled="true"
  {% endif %}
>
  {{ icon | default: 'icon-buy.svg' | inline_asset_content }}
  {{ text | default: 'Buy Now' }}
</a>
